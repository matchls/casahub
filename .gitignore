# Root .gitignore — covers all workspaces (apps/, packages/).
# apps/web has its own .gitignore with Next.js-specific entries; keep both.

# dependencies
node_modules/

# build output
.next/
out/
dist/
build/

# env files (never commit real secrets)
.env
.env.local
.env.*.local
!.env*.example

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# editor files
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
